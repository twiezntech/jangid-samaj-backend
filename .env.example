NODE_ENV=development
PORT=4100

# Local dev cluster lives in .pgdata on port 5433 (npm run db:start)
DATABASE_URL="postgresql://jangid:jangid_dev_pass@localhost:5433/jangid_samaj?schema=public"

JWT_ACCESS_SECRET="change_this_access_secret"
JWT_REFRESH_SECRET="change_this_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS - comma separated list of allowed origins (website, admin panel)
CORS_ORIGINS="http://localhost:3010,http://localhost:3020"

# Google Sign-In (OAuth client ID from Google Cloud Console). Same value goes in the website's NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=""
# Set to the parent domain in production (e.g. ".yourdomain.com") so website + api share cookies
COOKIE_DOMAIN=""

# --- Email (Resend: https://resend.com) ---
# Empty key = emails are printed to the API console (development only)
RESEND_API_KEY=""
MAIL_FROM="Jangid Samaj <no-reply@yourdomain.com>"
# Public website URL, used to build the verification link
APP_URL="http://localhost:3010"

# --- Bot protection (Cloudflare Turnstile: https://dash.cloudflare.com -> Turnstile) ---
TURNSTILE_SECRET_KEY=""

# --- Media ---
# Public origin of this API; uploaded images are served from ${PUBLIC_API_URL}/uploads/...
PUBLIC_API_URL="http://localhost:4100"
# Where uploaded files are written (relative to the project root)
UPLOAD_DIR="uploads"
# Comma separated external hosts allowed for stored image URLs (uploads are always allowed)
IMAGE_HOSTS="images.unsplash.com"

# --- Dev seed ---
# Fixed password for the dev accounts (admin@/editor@/district@/reporter@jangidsamaj.local); random if empty
SEED_DEV_PASSWORD=""
