generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums
// ===========================================================================

enum LocationLevel {
  STATE
  DISTRICT
  CITY
  TEHSIL
  VILLAGE
}

enum AuthProvider {
  MOBILE_OTP
  EMAIL_OTP
  PASSWORD
}

/// Shared editorial lifecycle for every publishable entity (news, directory, leaders).
enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum DirectoryType {
  ORGANIZATION
  COMMITTEE
  SAMAJ_BHAWAN
  CONTACT
}

enum LeaderCategory {
  SARPANCH
  ELECTED_REPRESENTATIVE
  SOCIAL_WORKER
  PRESIDENT
  COMMITTEE_MEMBER
  OTHER
}

/// Content languages. Adding a language = add a value here; no table changes needed.
enum Lang {
  hi
  en
}

/// Shared lifecycle for inbound messages (feedback, business enquiries).
enum InboxStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum EventCategory {
  MEETING
  CONFERENCE
  PARICHAY_SAMMELAN
  CULTURAL
  RELIGIOUS
  BLOOD_DONATION
  SOCIAL_SERVICE
  EDUCATION
  SPORTS
  OTHER
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

enum AchievementCategory {
  STUDENT
  PROFESSIONAL
  ENTREPRENEUR
  SPORTS
  SOCIAL
  OTHER
}

/// Used only to pick the honorific on a notice ("स्व. श्री" / "स्व. श्रीमती").
enum Gender {
  MALE
  FEMALE
}

/// Rites listed on a demise notice, in the order families usually announce them.
enum CeremonyType {
  ANTIM_YATRA
  UTHAVNA
  SHOK_SABHA
  PAGDI_RASM
  OTHER
}

/// Condolence messages are moderated before anyone else sees them.
enum TributeStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

// ===========================================================================
// Auth / RBAC
// ===========================================================================

model Role {
  id               String           @id @default(cuid())
  name             String           @unique // SUPER_ADMIN, CONTENT_EDITOR, DISTRICT_ADMIN, CITY_REPORTER, MEMBER ...
  description      String?
  /// Location-scoped roles (district admin, city reporter) may only act inside their own location subtree.
  isLocationScoped Boolean          @default(false)
  permissions      RolePermission[]
  users            User[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique // news.create, news.review, directory.manage ...
  label String
  roles RolePermission[]
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@id([roleId, permissionId])
}

model User {
  id               String    @id @default(cuid())
  name             String?
  mobile           String?   @unique
  email            String?   @unique
  passwordHash     String?
  googleId         String?   @unique
  avatarUrl        String?
  failedLogins     Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  isMobileVerified Boolean   @default(false)
  isEmailVerified  Boolean   @default(false)
  isActive         Boolean   @default(true)
  isSuspended      Boolean   @default(false)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  /// Home location. For location-scoped roles this is the root of their authority.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  otpCodes             OtpCode[]
  refreshTokens        RefreshToken[]
  emailTokens          EmailVerificationToken[]
  passwordResets       PasswordResetToken[]
  savedItems           SavedItem[]
  jobsPosted           Job[]                    @relation("JobCreator")
  jobApplications      JobApplication[]
  albumsMade           Album[]                  @relation("AlbumCreator")
  notifications        Notification[]
  announcementsSent    Announcement[]           @relation("AnnouncementSender")
  activityDays         UserActivityDay[]
  reportsFiled         ContentReport[]          @relation("ReportReporter")
  matrimonyProfile     MatrimonyProfile?
  adsCreated           Ad[]                     @relation("AdCreator")
  newsArticles         News[]                   @relation("NewsAuthor")
  directorySubmissions DirectoryEntry[]         @relation("DirectorySubmitter")
  leaderProfilesMade   LeaderProfile[]          @relation("LeaderCreator")
  leaderProfile        LeaderProfile?           @relation("LeaderAccount")
  eventsCreated        Event[]                  @relation("EventCreator")
  eventRegistrations   EventRegistration[]
  businesses           Business[]               @relation("BusinessOwner")
  businessEnquiries    BusinessEnquiry[]
  achievementsMade     Achievement[]            @relation("AchievementCreator")
  obituariesMade       Obituary[]               @relation("ObituaryCreator")
  tributes             ObituaryTribute[]
  uploads              Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([locationId])
}

model OtpCode {
  id         String       @id @default(cuid())
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?
  identifier String
  provider   AuthProvider
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int          @default(0)
  createdAt  DateTime     @default(now())

  @@index([identifier])
}

model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One-time password reset link (1 hour). Only the hash is stored.
model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// What a member can bookmark from the website.
enum SavedType {
  NEWS
  BUSINESS
  EVENT
  DIRECTORY
  LEADER
  ACHIEVEMENT
  OBITUARY
}

/// A bookmark. Title and image are captured when saving so the "Saved" list needs no joins across modules.
model SavedItem {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      SavedType
  slug      String
  title     String
  imageUrl  String?
  createdAt DateTime  @default(now())

  @@unique([userId, type, slug])
  @@index([userId, createdAt(sort: Desc)])
}

model Feedback {
  id        String      @id @default(cuid())
  name      String?
  email     String?
  category  String      @default("general")
  message   String
  userId    String?
  ip        String?
  status    InboxStatus @default(NEW)
  adminNote String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
}

/// Every uploaded file. Lets admins find/reuse images and gives cleanup jobs a source of truth.
model Media {
  id           String   @id @default(cuid())
  url          String   @unique
  mime         String
  size         Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([uploadedById, createdAt])
  @@index([createdAt])
}

/// Append-only trail of every privileged action (publish, verify, role change ...).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ===========================================================================
// Location hierarchy: State -> District -> City -> Tehsil -> Village
//
// `path` is a materialized slug path ("rajasthan/jaipur") so a whole subtree is
// one prefix query. Content rows additionally store stateId/districtId/cityId
// (denormalised at write time) so location filters are plain indexed equality.
// ===========================================================================

model Location {
  id        String        @id @default(cuid())
  nameHi    String
  nameEn    String
  level     LocationLevel
  slug      String
  path      String        @unique
  parentId  String?
  parent    Location?     @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Location[]    @relation("LocationTree")
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)

  users             User[]
  news              News[]
  directory         DirectoryEntry[]
  leaders           LeaderProfile[]
  events            Event[]
  businesses        Business[]
  achievements      Achievement[]
  obituaries        Obituary[]
  jobs              Job[]
  albums            Album[]
  announcements     Announcement[]
  matrimonyProfiles MatrimonyProfile[]
  ads               Ad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, slug])
  @@index([parentId, isActive])
  @@index([level, isActive])
}

// ===========================================================================
// Module 1: News
// ===========================================================================

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameHi    String
  nameEn    String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  news      News[]
  createdAt DateTime   @default(now())
}

model Tag {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameHi    String
  nameEn    String
  news      NewsTag[]
  createdAt DateTime  @default(now())
}

model News {
  id     String        @id @default(cuid())
  slug   String        @unique
  status ContentStatus @default(DRAFT)

  isBreaking Boolean @default(false)
  isFeatured Boolean @default(false)

  coverImageUrl String?
  /// Optional YouTube video shown at the top of the story (canonical watch URL).
  videoUrl      String?
  sourceName    String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  stateId    String?
  districtId String?
  cityId     String?

  authorId String?
  author   User?   @relation("NewsAuthor", fields: [authorId], references: [id])

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  publishedAt DateTime?
  scheduledAt DateTime?
  viewCount   Int       @default(0)
  /// Paid / promotional story; always labelled "Sponsored" on the website.
  isSponsored Boolean   @default(false)

  translations NewsTranslation[]
  tags         NewsTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([stateId, status, publishedAt(sort: Desc)])
  @@index([districtId, status, publishedAt(sort: Desc)])
  @@index([cityId, status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([authorId, updatedAt(sort: Desc)])
  @@index([status, scheduledAt])
}

model NewsTranslation {
  id              String  @id @default(cuid())
  news            News    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId          String
  lang            Lang
  title           String
  excerpt         String?
  /// Sanitised HTML (allow-list applied on write).
  body            String
  imageAlt        String?
  metaTitle       String?
  metaDescription String?

  @@unique([newsId, lang])
}

model NewsTag {
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@id([newsId, tagId])
  @@index([tagId])
}

// ===========================================================================
// Module 2: Samaj Directory
// ===========================================================================

model DirectoryEntry {
  id           String             @id @default(cuid())
  slug         String             @unique
  type         DirectoryType
  status       ContentStatus      @default(PENDING_REVIEW)
  verification VerificationStatus @default(UNVERIFIED)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  stateId    String?
  districtId String?
  cityId     String?

  pincode   String?
  latitude  Float?
  longitude Float?

  phone           String?
  altPhone        String?
  email           String?
  website         String?
  socials         Json?
  /// When false, phone/email are hidden from public responses (personal contacts).
  isContactPublic Boolean @default(true)

  coverImageUrl   String?
  establishedYear Int?
  sortOrder       Int     @default(0)

  submittedById String?
  submittedBy   User?   @relation("DirectorySubmitter", fields: [submittedById], references: [id])

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  verifiedAt      DateTime?

  translations DirectoryTranslation[]
  leaders      LeaderProfile[]
  events       Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, type, sortOrder])
  @@index([stateId, status, type])
  @@index([districtId, status, type])
  @@index([cityId, status, type])
  @@index([submittedById])
}

model DirectoryTranslation {
  id          String         @id @default(cuid())
  entry       DirectoryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId     String
  lang        Lang
  name        String
  description String?
  address     String?

  @@unique([entryId, lang])
}

// ===========================================================================
// Module 3: Leadership & Public Representatives
// ===========================================================================

model LeaderProfile {
  id           String             @id @default(cuid())
  slug         String             @unique
  category     LeaderCategory
  status       ContentStatus      @default(PENDING_REVIEW)
  verification VerificationStatus @default(UNVERIFIED)

  photoUrl String?

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  stateId    String?
  districtId String?
  cityId     String?

  organizationId String?
  organization   DirectoryEntry? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  termStart DateTime? @db.Date
  termEnd   DateTime? @db.Date

  phone           String?
  email           String?
  socials         Json?
  /// Personal contact details stay private unless the leader/admin explicitly opts in.
  isContactPublic Boolean @default(false)

  /// Optional link to the member account that manages/claims this profile.
  userId String? @unique
  user   User?   @relation("LeaderAccount", fields: [userId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("LeaderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  verifiedById    String?
  verifiedAt      DateTime?

  sortOrder Int @default(0)

  translations LeaderTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, category, sortOrder])
  @@index([stateId, status, category])
  @@index([districtId, status, category])
  @@index([cityId, status, category])
  @@index([organizationId])
}

model LeaderTranslation {
  id          String        @id @default(cuid())
  leader      LeaderProfile @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  leaderId    String
  lang        Lang
  name        String
  designation String?
  bio         String?

  @@unique([leaderId, lang])
}

// ===========================================================================
// Module 4: Community Events
// ===========================================================================

model Event {
  id       String        @id @default(cuid())
  slug     String        @unique
  status   ContentStatus @default(DRAFT)
  category EventCategory

  startsAt DateTime
  endsAt   DateTime?

  /// Online events carry a join link instead of (or in addition to) a venue.
  isOnline  Boolean @default(false)
  onlineUrl String?

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  stateId    String?
  districtId String?
  cityId     String?
  pincode    String?
  latitude   Float?
  longitude  Float?

  coverImageUrl String?
  /// Up to 30 image URLs (event gallery), same allow-list as cover images.
  gallery       Json?

  organizerName   String?
  organizerPhone  String?
  organizerEmail  String?
  isContactPublic Boolean @default(true)

  organizationId String?
  organization   DirectoryEntry? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  registrationEnabled  Boolean   @default(false)
  registrationDeadline DateTime?
  /// Maximum attendees (sum of party sizes). Null = unlimited.
  capacity             Int?
  /// Attendees currently booked; maintained atomically so capacity can never be oversold.
  seatsTaken           Int       @default(0)
  /// Entry fee in whole rupees. Null or 0 = free. Collected offline until payments ship.
  feeAmount            Int?

  isFeatured Boolean @default(false)

  createdById String?
  createdBy   User?   @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  publishedAt     DateTime?

  translations  EventTranslation[]
  registrations EventRegistration[]
  albums        Album[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
  @@index([stateId, status, startsAt])
  @@index([districtId, status, startsAt])
  @@index([cityId, status, startsAt])
  @@index([category, status, startsAt])
  @@index([createdById, updatedAt(sort: Desc)])
}

model EventTranslation {
  id          String  @id @default(cuid())
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  lang        Lang
  title       String
  summary     String?
  /// Sanitised HTML (same allow-list as news bodies).
  description String?
  venue       String?
  address     String?
  feeNote     String?

  @@unique([eventId, lang])
}

model EventRegistration {
  id          String             @id @default(cuid())
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  phone       String
  attendees   Int                @default(1)
  note        String?
  status      RegistrationStatus @default(CONFIRMED)
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([eventId, userId])
  @@index([eventId, status, createdAt])
  @@index([userId, createdAt])
}

// ===========================================================================
// Module 5: Business Directory
// ===========================================================================

model BusinessCategory {
  id         String     @id @default(cuid())
  slug       String     @unique
  nameHi     String
  nameEn     String
  /// lucide icon name used by the UI (e.g. "hammer", "store"); display-only.
  icon       String?
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(true)
  businesses Business[]
  createdAt  DateTime   @default(now())
}

model Business {
  id           String             @id @default(cuid())
  slug         String             @unique
  status       ContentStatus      @default(PENDING_REVIEW)
  verification VerificationStatus @default(UNVERIFIED)

  categoryId String
  category   BusinessCategory @relation(fields: [categoryId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  stateId    String?
  districtId String?
  cityId     String?
  pincode    String?
  latitude   Float?
  longitude  Float?

  phone    String?
  whatsapp String?
  email    String?
  website  String?
  socials  Json?

  logoUrl       String?
  coverImageUrl String?
  /// Up to 12 product/shop photos.
  gallery       Json?

  establishedYear Int?

  /// Paid placement: shown first while featuredUntil is in the future (null = until turned off).
  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?

  ownerId String?
  owner   User?   @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  verifiedAt      DateTime?
  sortOrder       Int       @default(0)

  translations BusinessTranslation[]
  enquiries    BusinessEnquiry[]
  jobs         Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isFeatured, sortOrder])
  @@index([categoryId, status])
  @@index([stateId, status])
  @@index([districtId, status])
  @@index([cityId, status])
  @@index([ownerId])
}

model BusinessTranslation {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  lang        Lang
  name        String
  tagline     String?
  description String?
  address     String?
  /// Current offers / discounts, plain text.
  offers      String?

  @@unique([businessId, lang])
}

/// A lead: a visitor asking a business to get in touch. Visible to the owner and managers only.
model BusinessEnquiry {
  id         String      @id @default(cuid())
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  phone      String
  email      String?
  message    String
  status     InboxStatus @default(NEW)
  ip         String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([businessId, status, createdAt])
  @@index([status, createdAt])
}

// ===========================================================================
// Phase 2 - Module 6: Community Achievements
// ===========================================================================

model Achievement {
  id       String              @id @default(cuid())
  slug     String              @unique
  category AchievementCategory
  status   ContentStatus       @default(PENDING_REVIEW)

  photoUrl   String?
  achievedOn DateTime? @db.Date

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  stateId    String?
  districtId String?
  cityId     String?

  /// Highlighted on the homepage / top of lists (managers only).
  isFeatured Boolean @default(false)

  createdById String?
  createdBy   User?   @relation("AchievementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  sortOrder       Int       @default(0)

  translations AchievementTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isFeatured, achievedOn(sort: Desc)])
  @@index([category, status])
  @@index([stateId, status])
  @@index([districtId, status])
  @@index([cityId, status])
  @@index([createdById])
}

model AchievementTranslation {
  id            String      @id @default(cuid())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String
  lang          Lang
  /// Who achieved it.
  personName    String
  /// What was achieved (headline).
  title         String
  description   String?

  @@unique([achievementId, lang])
}

// ===========================================================================
// Phase 3 - Gotra master data (used by matrimony / family fields later)
// ===========================================================================

/// Gotra-kar rishi (the sage a gotra descends from).
model Rishi {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEn    String
  nameHi    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  gotras    Gotra[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Gotra {
  id                      String             @id @default(cuid())
  nameEn                  String
  nameHi                  String?
  /// Lower-cased letters/digits of nameEn. Unique, so "Aslia", "ASLIA" and "A-slia" can never be added twice.
  nameKey                 String             @unique
  /// Restrict: a rishi that still has gotras cannot be deleted.
  rishiId                 String?
  rishi                   Rishi?             @relation(fields: [rishiId], references: [id], onDelete: Restrict)
  /// Hidden gotras stay in the table (profiles may reference them) but disappear from pickers and the website.
  isActive                Boolean            @default(true)
  obituaries              Obituary[]
  matrimonyProfiles       MatrimonyProfile[] @relation("ProfileGotra")
  matrimonyMotherProfiles MatrimonyProfile[] @relation("ProfileMotherGotra")
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([isActive, nameEn])
  @@index([rishiId, isActive])
}

// ===========================================================================
// Phase 2 - Obituaries / Tributes (शोक संदेश व श्रद्धांजलि)
// ===========================================================================

/// A demise notice submitted by the family (or staff) and published after review.
model Obituary {
  id     String        @id @default(cuid())
  slug   String        @unique
  status ContentStatus @default(PENDING_REVIEW)

  gender      Gender?
  photoUrl    String?
  dateOfBirth DateTime? @db.Date
  dateOfDeath DateTime  @db.Date
  /// Used when the exact date of birth is not known.
  ageYears    Int?

  gotraId String?
  gotra   Gotra?  @relation(fields: [gotraId], references: [id], onDelete: SetNull)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  stateId    String?
  districtId String?
  cityId     String?

  /// Family contact. The phone stays private unless the family opts in.
  contactName     String?
  contactRelation String?
  contactPhone    String?
  isContactPublic Boolean @default(false)

  createdById String?
  createdBy   User?   @relation("ObituaryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  translations ObituaryTranslation[]
  ceremonies   ObituaryCeremony[]
  tributes     ObituaryTribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dateOfDeath(sort: Desc)])
  @@index([stateId, status])
  @@index([districtId, status])
  @@index([cityId, status])
  @@index([createdById])
}

model ObituaryTranslation {
  id            String   @id @default(cuid())
  obituary      Obituary @relation(fields: [obituaryId], references: [id], onDelete: Cascade)
  obituaryId    String
  lang          Lang
  /// Full name of the deceased, without the "स्व." prefix (added on display).
  name          String
  /// "S/o Late Shri ...", "W/o Shri ..." etc.
  relationLine  String?
  nativePlace   String?
  biography     String?
  /// Words from the family and the list of mourners (शोकाकुल परिवार).
  familyMessage String?

  @@unique([obituaryId, lang])
}

/// Antim yatra, uthavna, shok sabha... Written once in the language the family used.
model ObituaryCeremony {
  id         String       @id @default(cuid())
  obituary   Obituary     @relation(fields: [obituaryId], references: [id], onDelete: Cascade)
  obituaryId String
  type       CeremonyType
  startsAt   DateTime
  venue      String
  address    String?
  note       String?
  sortOrder  Int          @default(0)

  @@index([obituaryId, startsAt])
  @@index([startsAt])
}

/// A member's condolence message. One per member per notice; posting again replaces it and sends it back to review.
model ObituaryTribute {
  id         String        @id @default(cuid())
  obituary   Obituary      @relation(fields: [obituaryId], references: [id], onDelete: Cascade)
  obituaryId String
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Display name captured when posting, so the tribute survives later account changes.
  authorName String
  relation   String?
  message    String
  status     TributeStatus @default(PENDING)

  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([obituaryId, userId])
  @@index([obituaryId, status, createdAt])
  @@index([status, createdAt])
}

// ===========================================================================
// Phase 2 - Jobs & Opportunities
// ===========================================================================

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  BUSINESS_OPPORTUNITY
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

/// A vacancy, hiring post or business opportunity posted by a member or staff and published after review.
model Job {
  id       String        @id @default(cuid())
  slug     String        @unique
  status   ContentStatus @default(PENDING_REVIEW)
  type     JobType
  workMode WorkMode      @default(ONSITE)

  /// Hiring business / employer name (not translated).
  organisationName String
  businessId       String?
  business         Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  stateId    String?
  districtId String?
  cityId     String?

  /// Monthly salary range in INR (optional).
  salaryMin       Int?
  salaryMax       Int?
  experienceYears Int?
  vacancies       Int?
  /// Applications close at the end of this day (IST). Expired jobs leave the public list.
  lastDate        DateTime? @db.Date

  /// How to apply outside the site. The in-site application form is always available too.
  applyUrl   String?
  applyEmail String?
  applyPhone String?

  isFeatured Boolean @default(false)

  createdById String?
  createdBy   User?   @relation("JobCreator", fields: [createdById], references: [id], onDelete: SetNull)

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  translations JobTranslation[]
  applications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isFeatured, createdAt(sort: Desc)])
  @@index([type, status])
  @@index([stateId, status])
  @@index([districtId, status])
  @@index([cityId, status])
  @@index([createdById])
}

model JobTranslation {
  id           String  @id @default(cuid())
  job          Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId        String
  lang         Lang
  title        String
  description  String
  requirements String?

  @@unique([jobId, lang])
}

/// An application sent through the website. The poster and job managers can read it.
model JobApplication {
  id        String      @id @default(cuid())
  job       Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  phone     String
  email     String?
  message   String
  status    InboxStatus @default(NEW)
  createdAt DateTime    @default(now())

  @@unique([jobId, userId])
  @@index([jobId, createdAt(sort: Desc)])
}

// ===========================================================================
// Phase 2 - Photo & Video Gallery
// ===========================================================================

enum GalleryItemKind {
  PHOTO
  VIDEO
}

model Album {
  id     String        @id @default(cuid())
  slug   String        @unique
  status ContentStatus @default(PENDING_REVIEW)
  /// What kind of album this is, so success stories, interviews and reels get their own tabs.
  category AlbumCategory @default(EVENT)

  coverUrl String?
  takenOn  DateTime? @db.Date

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  stateId    String?
  districtId String?
  cityId     String?

  isFeatured Boolean @default(false)

  createdById String?
  createdBy   User?   @relation("AlbumCreator", fields: [createdById], references: [id], onDelete: SetNull)

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  translations AlbumTranslation[]
  items        GalleryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isFeatured, takenOn(sort: Desc)])
  @@index([eventId])
  @@index([category, status])
  @@index([stateId, status])
  @@index([districtId, status])
  @@index([cityId, status])
  @@index([createdById])
}

model AlbumTranslation {
  id          String  @id @default(cuid())
  album       Album   @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId     String
  lang        Lang
  title       String
  description String?

  @@unique([albumId, lang])
}

/// A photo (our upload) or a YouTube video inside an album.
model GalleryItem {
  id        String          @id @default(cuid())
  album     Album           @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId   String
  kind      GalleryItemKind
  url       String
  caption   String?
  sortOrder Int             @default(0)

  @@index([albumId, sortOrder])
}

// ===========================================================================
// Notifications & announcements
// ===========================================================================

enum NotificationType {
  APPROVED
  REJECTED
  TRIBUTE
  JOB_APPLICATION
  INTEREST
  INTEREST_ACCEPTED
  ANNOUNCEMENT
  SYSTEM
}

/// In-site inbox (the bell). Push / SMS / WhatsApp channels can fan out from the same rows later.
model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  titleHi   String
  titleEn   String
  bodyHi    String?
  bodyEn    String?
  /// Site-relative link ("/news/slug").
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

/// A broadcast written in the admin panel, delivered to every member (or the members of one area).
model Announcement {
  id         String    @id @default(cuid())
  /// Who receives it, on top of the optional area filter.
  segment    AnnouncementSegment @default(EVERYONE)
  titleHi    String
  titleEn    String
  bodyHi     String?
  bodyEn     String?
  link       String?
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  recipients Int       @default(0)
  sentById   String?
  sentBy     User?     @relation("AnnouncementSender", fields: [sentById], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
}

// ===========================================================================
// Reporting content and profiles
// ===========================================================================

enum ReportTarget {
  NEWS
  BUSINESS
  EVENT
  DIRECTORY
  LEADER
  ACHIEVEMENT
  OBITUARY
  TRIBUTE
  JOB
  ALBUM
  MATRIMONY
}

enum ReportReason {
  SPAM
  FAKE
  OFFENSIVE
  WRONG_INFO
  PRIVACY
  OTHER
}

model ContentReport {
  id           String       @id @default(cuid())
  targetType   ReportTarget
  /// Slug for public pages, id for tributes and matrimony profiles.
  targetId     String
  reason       ReportReason
  details      String?
  reporterId   String?
  reporter     User?        @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  status       InboxStatus  @default(NEW)
  adminNote    String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
}

// ===========================================================================
// Phase 3 - Matrimony (rishte)
// ===========================================================================

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
}

enum ProfileFor {
  SELF
  SON
  DAUGHTER
  BROTHER
  SISTER
  RELATIVE
}

enum Manglik {
  NO
  YES
  ANSHIK
  DONT_KNOW
}

enum EducationLevel {
  SCHOOL
  DIPLOMA
  GRADUATE
  POST_GRADUATE
  DOCTORATE
  PROFESSIONAL
}

enum IncomeRange {
  UNDER_3L
  L3_TO_6L
  L6_TO_10L
  L10_TO_20L
  ABOVE_20L
  NOT_SPECIFIED
}

enum PhotoVisibility {
  MEMBERS
  ON_ACCEPT
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// One matrimonial profile per account (a parent may create it for a son or daughter).
/// Contact details are revealed only after an interest is accepted by either side.
model MatrimonyProfile {
  id           String             @id @default(cuid())
  /// Short public reference shown on cards ("JS10234").
  code         String             @unique
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       ContentStatus      @default(PENDING_REVIEW)
  verification VerificationStatus @default(UNVERIFIED)
  profileFor   ProfileFor         @default(SELF)

  name          String
  gender        Gender
  dateOfBirth   DateTime      @db.Date
  heightCm      Int?
  maritalStatus MaritalStatus @default(NEVER_MARRIED)
  manglik       Manglik       @default(DONT_KNOW)

  gotraId       String?
  gotra         Gotra?  @relation("ProfileGotra", fields: [gotraId], references: [id], onDelete: SetNull)
  /// The mother's gotra; families use it to rule out matches.
  motherGotraId String?
  motherGotra   Gotra?  @relation("ProfileMotherGotra", fields: [motherGotraId], references: [id], onDelete: SetNull)

  educationLevel EducationLevel?
  education      String?
  profession     String?
  income         IncomeRange     @default(NOT_SPECIFIED)

  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  stateId     String?
  districtId  String?
  cityId      String?
  nativePlace String?

  fatherName       String?
  fatherOccupation String?
  motherName       String?
  siblings         String?
  about            String?

  /// Partner preference (age range + free text).
  prefAgeMin Int?
  prefAgeMax Int?
  prefNotes  String?

  photos          String[]
  photoVisibility PhotoVisibility @default(MEMBERS)

  /// Optional PDF biodata. Shown only where the phone number is shown (after an accepted interest).
  biodataUrl String?

  contactPhone    String
  contactWhatsapp String?

  /// The owner can hide the profile without deleting it.
  isHidden Boolean @default(false)

  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  lastActiveAt    DateTime  @default(now())

  sentInterests     MatrimonyInterest[]  @relation("InterestFrom")
  receivedInterests MatrimonyInterest[]  @relation("InterestTo")
  shortlists        MatrimonyShortlist[] @relation("ShortlistOwner")
  shortlistedBy     MatrimonyShortlist[] @relation("ShortlistTarget")
  blocks            MatrimonyBlock[]     @relation("BlockOwner")
  blockedBy         MatrimonyBlock[]     @relation("BlockTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isHidden, gender, dateOfBirth])
  @@index([stateId, status])
  @@index([districtId, status])
  @@index([gotraId])
}

model MatrimonyInterest {
  id          String           @id @default(cuid())
  fromId      String
  from        MatrimonyProfile @relation("InterestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String
  to          MatrimonyProfile @relation("InterestTo", fields: [toId], references: [id], onDelete: Cascade)
  status      InterestStatus   @default(PENDING)
  message     String?
  respondedAt DateTime?
  createdAt   DateTime         @default(now())

  @@unique([fromId, toId])
  @@index([toId, status])
  @@index([fromId, status])
}

model MatrimonyShortlist {
  ownerId   String
  owner     MatrimonyProfile @relation("ShortlistOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    MatrimonyProfile @relation("ShortlistTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@id([ownerId, targetId])
}

/// A blocked profile never appears in the blocker's search and cannot send them interests.
model MatrimonyBlock {
  ownerId   String
  owner     MatrimonyProfile @relation("BlockOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    MatrimonyProfile @relation("BlockTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@id([ownerId, targetId])
}

// ===========================================================================
// Ads & monetization
// ===========================================================================

enum AdPlacement {
  HOME_TOP
  HOME_FEED
  SIDEBAR
  ARTICLE_INLINE
  LIST_TOP
}

/// A banner campaign. Shown only between startsAt and endsAt, optionally only inside one area.
model Ad {
  id          String      @id @default(cuid())
  name        String
  advertiser  String
  placement   AdPlacement
  imageUrl    String
  linkUrl     String
  altText     String
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean     @default(true)
  /// Higher weight = shown more often when several ads share a slot.
  weight      Int         @default(1)
  locationId  String?
  location    Location?   @relation(fields: [locationId], references: [id])
  stateId     String?
  districtId  String?
  cityId      String?
  impressions Int         @default(0)
  clicks      Int         @default(0)
  createdById String?
  createdBy   User?       @relation("AdCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([placement, isActive, startsAt, endsAt])
}

// ===========================================================================
// Analytics (privacy friendly: daily counters, no personal data)
// ===========================================================================

model DailyPageView {
  day     DateTime @db.Date
  path    String
  section String
  views   Int      @default(0)

  @@id([day, path])
  @@index([day, section])
}

model DailySearch {
  day   DateTime @db.Date
  term  String
  count Int      @default(0)

  @@id([day, term])
}

enum AlbumCategory {
  EVENT
  SUCCESS_STORY
  INTERVIEW
  REEL
  COMMUNITY
}

enum AnnouncementSegment {
  EVERYONE
  BUSINESS_OWNERS
  MATRIMONY_MEMBERS
  EVENT_ATTENDEES
}

/// One row per signed-in member per day they used the website. Powers retention and active-user numbers;
/// anonymous visitors are never recorded here.
model UserActivityDay {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date

  @@id([userId, day])
  @@index([day])
}
